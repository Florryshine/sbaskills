diff --git a/components/MasteryChecklist.js b/components/MasteryChecklist.js
new file mode 100644
index 0000000..edf5b90
--- /dev/null
+++ b/components/MasteryChecklist.js
@@ -0,0 +1,48 @@
+import { evaluateLevelUp } from '@/lib/mastery';
+
+const PILLAR_LABELS = {
+  learningMastery: { label: 'Learning Mastery', emoji: '📚' },
+  assessmentChampion: { label: 'Assessment Champion', emoji: '🧠' },
+  scholarRecognition: { label: 'Scholar Recognition', emoji: '🏆' },
+  consistency: { label: 'Consistency', emoji: '🔥' },
+};
+
+export default function MasteryChecklist({ totalPoints, stats }) {
+  const evalResult = evaluateLevelUp(totalPoints, stats);
+
+  if (evalResult.atMaxLevel) {
+    return (
+      <div className="rounded-2xl bg-white border border-gray-100 shadow-sm p-4 text-sm text-gray-500">
+        You've hit the top level — SBA Legend. 👑
+      </div>
+    );
+  }
+
+  return (
+    <div className="rounded-2xl bg-white border border-gray-100 shadow-sm p-4">
+      <p className="font-bold text-brand-blue mb-1">
+        Level {evalResult.nextLevel} unlocks when: XP requirement {evalResult.xpMet ? '✅' : '⬜'} + any 3 of 4 below
+      </p>
+      <p className="text-xs text-gray-400 mb-3">
+        {evalResult.pillarsMet}/4 completed
+      </p>
+      <ul className="space-y-1.5">
+        {Object.entries(PILLAR_LABELS).map(([key, { label, emoji }]) => {
+          const met = evalResult.pillarResults[key];
+          const target = evalResult.targets[key];
+          const current = stats[key];
+          return (
+            <li key={key} className="flex items-center justify-between text-sm">
+              <span>
+                {emoji} {label}
+              </span>
+              <span className={met ? 'text-green-600 font-semibold' : 'text-gray-400'}>
+                {met ? '✅' : `${current}/${target}`}
+              </span>
+            </li>
+          );
+        })}
+      </ul>
+    </div>
+  );
+}
diff --git a/lib/gamification.js b/lib/gamification.js
index 43c6df8..f8c7d22 100644
--- a/lib/gamification.js
+++ b/lib/gamification.js
@@ -117,5 +117,34 @@ export async function completeActivity(studentId, activityType, activityId, poin
   }
 
   await addPoints(studentId, points, `Completed ${activityType}`, activityType, activityId);
+
+  // Referral payout was previously dormant — addReferralPoints() existed
+  // but nothing ever called it. Now fires here, on the referred student's
+  // FIRST completed activity (this insert above was rejected as a dup if
+  // one already existed, so reaching here with no prior row means this
+  // genuinely is their first) — not on raw signup, which is the anti-abuse
+  // condition flagged earlier (stops fake accounts farming referral XP).
+  try {
+    const { count: priorActivity } = await supabase
+      .from('student_progress')
+      .select('id', { count: 'exact', head: true })
+      .eq('student_id', studentId);
+
+    if (priorActivity === 1) {
+      const { data: profile } = await supabase
+        .from('profiles')
+        .select('referred_by, referral_rewarded')
+        .eq('id', studentId)
+        .maybeSingle();
+
+      if (profile?.referred_by && !profile.referral_rewarded) {
+        await addReferralPoints(profile.referred_by, studentId);
+        await supabase.from('profiles').update({ referral_rewarded: true }).eq('id', studentId);
+      }
+    }
+  } catch (e) {
+    console.error('Referral payout check failed:', e);
+  }
+
   return { success: true, points };
 }
