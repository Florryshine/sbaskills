# SBA Social Publishing — environment variables
# Copy to .env (local) or set in Vercel → Project → Settings → Environment Variables.

# ---------------------------------------------------------------------------
# Database
# Local sandbox uses SQLite via Prisma. Production (Supabase) uses the SQL
# migration in supabase/migrations — the app talks to Postgres through the
# same Prisma models (switch datasource provider to postgresql when porting).
# ---------------------------------------------------------------------------
DATABASE_URL=file:/home/z/my-project/db/custom.db

# ---------------------------------------------------------------------------
# Storage (production = Supabase Storage; omit for local disk storage)
# When both are set, the Supabase driver activates automatically and all media
# binaries are stored as bucket objects (never in database rows).
# ---------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=media

# ---------------------------------------------------------------------------
# Worker / cron
# The publishing worker can be triggered by:
#   * Vercel Cron (vercel.json schedules /api/cron/worker every minute)
#   * any external scheduler hitting /api/cron/worker with a Bearer token
#   * the "Run worker now" button in the UI
# CRON_SECRET protects the cron endpoint. REQUIRED in production.
# ---------------------------------------------------------------------------
CRON_SECRET=

# ---------------------------------------------------------------------------
# Platform credentials
# Channel credentials (page tokens, OAuth tokens, bot tokens) are stored PER
# CHANNEL in the channels table (credentials_json) and managed in the UI.
# The variables below are only needed if you later wire real OAuth apps so the
# app can mint/refresh those tokens itself (current design: paste/reconnect via
# the Channels screen; your existing working Facebook connection is untouched).
# ---------------------------------------------------------------------------
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=