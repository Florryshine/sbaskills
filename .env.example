NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Gemini expressive text-to-speech (falls back to existing Edge TTS if unavailable)
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
GEMINI_TTS_VOICE_A=Kore
GEMINI_TTS_VOICE_B=Charon
# Optional: TTS_PROVIDER=edge to force the existing Nigerian Edge voices

# Facebook Login (Facebook Pages only)
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=https://shineybrainacademy.vercel.app/api/auth/facebook/callback

# Instagram API with Meta Unified Login (separate Connect Instagram button)
# Uses the existing META_APP_ID and META_APP_SECRET.
# Create a Facebook Login for Business configuration for Instagram assets and copy its Configuration ID.
INSTAGRAM_UNIFIED_CONFIG_ID=
INSTAGRAM_REDIRECT_URI=https://shineybrainacademy.vercel.app/api/auth/instagram/callback

# LinkedIn OAuth
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=https://shineybrainacademy.vercel.app/api/auth/linkedin/callback

# YouTube OAuth
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=https://shineybrainacademy.vercel.app/api/auth/youtube/callback

# TikTok OAuth
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://shineybrainacademy.vercel.app/api/auth/tiktok/callback
