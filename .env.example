NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Gemini expressive text-to-speech (falls back to existing Edge TTS if unavailable)
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
GEMINI_TTS_VOICE_A=Kore
GEMINI_TTS_VOICE_B=Charon
# Optional: TTS_PROVIDER=edge to force the existing Nigerian Edge voices

# Facebook Login (Facebook Pages only)
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=https://shineybrainacademy.vercel.app/api/auth/facebook/callback

# Instagram API with Meta Unified Login (separate Connect Instagram button)
# Uses the existing META_APP_ID and META_APP_SECRET.
# Create a Facebook Login for Business configuration for Instagram assets and copy its Configuration ID.
INSTAGRAM_UNIFIED_CONFIG_ID=
INSTAGRAM_REDIRECT_URI=https://shineybrainacademy.vercel.app/api/auth/instagram/callback

# LinkedIn OAuth
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=https://shineybrainacademy.vercel.app/api/auth/linkedin/callback

# YouTube OAuth
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=https://shineybrainacademy.vercel.app/api/auth/youtube/callback

# TikTok OAuth
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://shineybrainacademy.vercel.app/api/auth/tiktok/callback

# ---------------------------------------------------------------------------
# Visual Learning Video Production Engine (100% free, no paid APIs)
# ---------------------------------------------------------------------------
# Worker: bun local-video-renderer/visual-learning-worker.js
# TTS chain: edge-tts (residential IPs) -> this free public proxy -> timed silence
TTS_ENDPOINT=https://openai-edge-tts-aqq1.onrender.com
# Free stock-image keys (already wired to GitHub secrets; free tiers, no cost)
# PEXELS_API_KEY=your_pexels_key
# PIXABAY_API_KEY=your_pixabay_key
# Image chain: pollinations (AI, no key) -> pixabay -> pexels -> wikimedia -> openverse (no key) -> SVG fallback
# VL_IMAGE_PROVIDER=            # pollinations | pexels | pixabay | wikimedia | openverse | placeholder
# VL_NARRATION_PROVIDER=        # edge | proxy | silent (auto-chain if unset)
# VL_MAX_SHOT_SECONDS=3         # no image stays on screen longer than this
# VISUAL_LEARNING_WORKER_POLL_MS=15000
# VISUAL_LEARNING_RUN_ONCE=1    # GitHub Actions / CI mode
# VISUAL_LEARNING_AUTO_PUBLISH=0
# CHROME_PATH=/usr/bin/chromium-browser
# REMOTION_CONCURRENCY=2
