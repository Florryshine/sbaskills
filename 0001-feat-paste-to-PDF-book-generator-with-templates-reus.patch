+    accent: '#38bdf8',
+    muted: '#64748b',
+    pageBackground: '#ffffff',
+    textColor: '#0f172a',
+    headerTextColor: '#ffffff',
+  },
+  workbook: {
+    ...brand,
+    key: 'workbook',
+    label: 'Student Workbook',
+    primary: '#166534',
+    accent: '#facc15',
+    muted: '#4b5563',
+    pageBackground: '#fffdf5',
+    textColor: '#1a1a1a',
+    headerTextColor: '#ffffff',
+  },
+  premium: {
+    ...brand,
+    key: 'premium',
+    label: 'Premium Ebook',
+    primary: '#111827',
+    accent: '#c9a227',
+    muted: '#6b7280',
+    pageBackground: '#fbfaf7',
+    textColor: '#111827',
+    headerTextColor: '#f5f0e1',
+  },
+  minimal: {
+    ...brand,
+    key: 'minimal',
+    label: 'Minimal',
+    primary: '#1f2937',
+    accent: '#9ca3af',
+    muted: '#9ca3af',
+    pageBackground: '#ffffff',
+    textColor: '#1f2937',
+    headerTextColor: '#ffffff',
+  },
+  dark: {
+    ...brand,
+    key: 'dark',
+    label: 'Dark Mode',
+    primary: '#0b0f19',
